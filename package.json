{
  "name": "pro-studio",
  "private": true,
  "version": "0.0.0",
  "description": "Browser-first beatmaking studio for trap, drill, R&B and Afrobeat.",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @pro-studio/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:scripts": "node --test \"scripts/test/*.test.mjs\"",
    "contrast": "pnpm --filter @pro-studio/ui contrast",
    "check:deps": "node scripts/check-deps.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:sounds": "node scripts/check-sounds.mjs",
    "check:budget": "node scripts/check-budget.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "e2e": "pnpm --filter @pro-studio/web e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0"
  }
}
